    "dev": "next dev",
    "prebuild": "npm run build:physical-annotation-catalog",
    "build": "next build",
    "build:meta": "node scripts/build-limitless-major-meta.mjs",
    "build:card-cache": "node scripts/build-card-reference-cache.mjs",
    "sync:card-reference": "node scripts/sync-card-reference-cache.mjs",
    "build:current-format": "node scripts/build-current-format-manifest.mjs",
    "test:current-format": "node scripts/test-current-format.mjs",
    "test:card-reference-sync": "node scripts/test-card-reference-sync.mjs",
    "build:card-cache:japanese-fixtures": "node scripts/build-japanese-fixture-card-image-cache.mjs",
    "test:deck-export": "node --experimental-strip-types scripts/test-deck-export.mjs",
    "sync:pokemon-sprites": "node scripts/sync-pokemon-sprites.mjs",
    "build:pokemon-sprites": "node scripts/build-pokemon-sprites.mjs",
    "test:sprite-normalization": "node scripts/test-sprite-normalization.mjs",
    "validate:card-cache": "node scripts/validate-card-reference-cache.mjs",
    "list:deck-image-fixtures": "node scripts/list-deck-image-fixtures.mjs",
