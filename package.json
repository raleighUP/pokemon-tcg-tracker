    "evaluate:deck-image-importer:physical": "node scripts/evaluate-deck-image-importer-physical.mjs",
    "evaluate:deck-image-importer:legacy": "node scripts/evaluate-deck-image-importer-digital.mjs",
    "evaluate:deck-image-importer:validation": "node scripts/evaluate-deck-image-importer-digital.mjs --group validation",
    "validate:fixture-reference-coverage": "node scripts/validate-fixture-reference-coverage.mjs",
    "test:digital-recognition-policy": "node scripts/test-digital-recognition-policy.mjs",
    "test:match-outcomes": "node --experimental-strip-types scripts/test-match-outcomes.mjs",
    "test:interface-accessibility": "node scripts/qa-match-history-responsive.mjs",
    "test:pokemon-identity": "node scripts/test-pokemon-identity.mjs",
    "test:physical-strategy-routing": "node scripts/test-physical-strategy-routing.mjs",
    "build:physical-annotation-catalog": "node scripts/build-physical-annotation-catalog.mjs",
    "test:physical-annotations": "node --experimental-strip-types scripts/test-physical-annotations.mjs",
    "test:physical-region-geometry": "node --experimental-strip-types scripts/test-physical-region-geometry.mjs",
    "test:physical-region-suppression": "node --experimental-strip-types scripts/test-physical-region-suppression.mjs",
    "validate:physical-fixtures": "node scripts/validate-physical-fixtures.mjs",
    "evaluate:physical-regions": "node scripts/evaluate-physical-regions.mjs",
    "evaluate:physical-localization-strategies": "node scripts/evaluate-physical-localization-strategies.mjs",
    "analyze:physical-fixture-geometry": "node scripts/analyze-physical-fixture-geometry.mjs",
    "validate:physical-training-dataset": "node scripts/validate-physical-training-dataset.mjs",
    "export:physical-localization-dataset": "node scripts/export-physical-localization-dataset.mjs",
    "split:physical-localization-dataset": "node scripts/split-physical-localization-dataset.mjs",
    "analyze:physical-training-dataset": "node scripts/analyze-physical-training-dataset.mjs",
    "generate:physical-synthetic-preview": "node scripts/generate-physical-synthetic-preview.mjs",
    "import:physical-training-photos": "node scripts/import-physical-training-photos.mjs",
    "test:physical-training-intake": "node scripts/test-physical-training-intake.mjs",
    "test:deck-image-importer:parity": "node scripts/evaluate-deck-image-importer-browser.mjs",
    "test:deck-image-importer:digital": "npm run evaluate:deck-image-importer:digital && node scripts/assert-deck-image-importer-digital-baseline.mjs",
    "start": "node scripts/serve-static.mjs",
    "preview": "node scripts/serve-static.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "benchmark:deck-images": "node scripts/evaluate-deck-image-importer.mjs",
    "native:build": "npm run build && npm run verify:static && npm run cap:sync",
    "native:verify:ios": "node scripts/verify-ios-package.mjs",
    "cap:copy": "cap copy",
    "cap:sync": "cap sync && node scripts/normalize-capacitor-spm.mjs",
    "cap:sync:ios": "cap sync ios && node scripts/normalize-capacitor-spm.mjs",
    "cap:sync:android": "cap sync android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  }
}
